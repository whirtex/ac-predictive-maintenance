/*
  Template for the Wi-Fi credentials.

  This file is the one that goes in the repository. It holds no password:
  it only tells whoever clones the project what needs to be created.

  To use it:
    1. copy this file as credentials.h, in the same folder
    2. fill in the network name and the password
    3. upload as usual

  credentials.h is blocked in .gitignore and never goes to GitHub. The
  repository is public, so a password in the code would be visible to anyone,
  and deleting it later does not help: it stays in the git history.
*/

#ifndef CREDENTIALS_H
#define CREDENTIALS_H

const char* WIFI_SSID     = "network name";
const char* WIFI_PASSWORD = "network password";

#endif
