#!/bin/sh
# Presentation panel: the adaptive detector learns what is normal in place
# during the first 2 minutes and then watches, relearning every minute.
# It shows the updates, the peaks and the continuous anomalies.
#
# ./present backup   plays recorded session 3 with a simulated fault at
#                    3 minutes, in case the board fails on the spot.
cd "$(dirname "$0")" || exit 1
if [ "$1" = "backup" ]; then
    exec .venv/bin/python analysis/ap1/adaptive_panel.py --replay data/rep3.csv --fault 180
fi
exec .venv/bin/python analysis/ap1/adaptive_panel.py
